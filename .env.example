# ------------------------------------------------------------------------------
# 1. Next.js Core Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. Supabase Database & Auth (Postgres + RLS)
# ------------------------------------------------------------------------------
# Public Supabase URL (accessible on client & server)
NEXT_PUBLIC_SUPABASE_URL="https://qkslcrhocsuyzynhhqqt.supabase.co"

# Public Anon Key (safe for client-side API calls with RLS enforcement)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFrc2xjcmhvY3N1eXp5bmhocXF0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ4MDcwNDAsImV4cCI6MjEwMDM4MzA0MH0.PTE7CAa6sI56S9SMuYM70b1rOn9PJy8vov1CV6myH1s"

# Service Role Key (SERVER ONLY - bypasses RLS policies for admin actions)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFrc2xjcmhvY3N1eXp5bmhocXF0Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4NDgwNzA0MCwiZXhwIjoyMTAwMzgzMDQwfQ.tX5Eo65WnMcmyNrPZU2hTR-91v6Q4Es8jo1qsfLp3MA"

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 Object Storage (ADR-0003 Presigned Download Links)
# ------------------------------------------------------------------------------
# Cloudflare Account ID & S3 API Access Credentials
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"

# Bucket name holding private digital asset source packages (.zip / .aep / .blend)
R2_BUCKET_NAME="celitecreators-source-files"

# Public R2 Domain for presigned download URL generation (15-minute TTL)
R2_PUBLIC_URL="https://r2.celitecreators.in"

# ------------------------------------------------------------------------------
# 4. Razorpay Payments (ADR-0004 Single-Item Checkout in INR ₹)
# ------------------------------------------------------------------------------
# Public Razorpay Key ID (used in client-side Razorpay Checkout modal)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Razorpay Key Secret (SERVER ONLY - used for Order API creation & HMAC verification)
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Webhook Secret for timing-safe HMAC SHA-256 payment verification
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"
